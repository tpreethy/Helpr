{
  "permissions": {
    "allow": [
      "PowerShell(winget install Oven-sh.Bun --accept-source-agreements --accept-package-agreements)",
      "PowerShell(dotnet new sln -n Helpr)",
      "PowerShell(dotnet new webapi -n Helpr.API -o src/Helpr.API --use-controllers --no-openapi)",
      "PowerShell(dotnet new classlib -n Helpr.Core -o src/Helpr.Core)",
      "PowerShell(dotnet new classlib -n Helpr.Infrastructure -o src/Helpr.Infrastructure)",
      "PowerShell(dotnet sln add src/Helpr.API/Helpr.API.csproj)",
      "PowerShell(dotnet sln add src/Helpr.Core/Helpr.Core.csproj)",
      "PowerShell(dotnet sln add src/Helpr.Infrastructure/Helpr.Infrastructure.csproj)",
      "PowerShell(dotnet add src/Helpr.API/Helpr.API.csproj reference src/Helpr.Core/Helpr.Core.csproj)",
      "PowerShell(dotnet add src/Helpr.API/Helpr.API.csproj reference src/Helpr.Infrastructure/Helpr.Infrastructure.csproj)",
      "PowerShell(dotnet add src/Helpr.Infrastructure/Helpr.Infrastructure.csproj reference src/Helpr.Core/Helpr.Core.csproj)",
      "PowerShell(dotnet add src/Helpr.Infrastructure/Helpr.Infrastructure.csproj package Microsoft.EntityFrameworkCore)",
      "PowerShell(dotnet add src/Helpr.Infrastructure/Helpr.Infrastructure.csproj package Npgsql.EntityFrameworkCore.PostgreSQL)",
      "PowerShell(dotnet add src/Helpr.Infrastructure/Helpr.Infrastructure.csproj package Microsoft.EntityFrameworkCore.Design)",
      "PowerShell(dotnet add src/Helpr.API/Helpr.API.csproj package Swashbuckle.AspNetCore)",
      "PowerShell(dotnet add src/Helpr.API/Helpr.API.csproj package Microsoft.EntityFrameworkCore.Design)",
      "PowerShell(dotnet build Helpr.sln)"
    ]
  }
}
